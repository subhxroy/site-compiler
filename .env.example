# ==============================================================================
# SiteCompiler Environment Variables Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (used by Render backend)
PORT=3001

# ------------------------------------------------------------------------------
# NETLIFY (FRONTEND) CONFIGURATION
# ------------------------------------------------------------------------------
# Set this in your Netlify Site Settings -> Environment Variables.
# Points the Netlify frontend to your live Render backend API.
NEXT_PUBLIC_API_URL=https://site-compiler.onrender.com

# ------------------------------------------------------------------------------
# RENDER (BACKEND) CONFIGURATION
# ------------------------------------------------------------------------------
# Set this in your Render Dashboard -> Environment Variables.
# Configures CORS to accept requests from your Netlify frontend domain.
FRONTEND_URL=https://site-compiler.netlify.app

# ------------------------------------------------------------------------------
# GITHUB ACTIONS 24/7 KEEP-ALIVE CONFIGURATION
# ------------------------------------------------------------------------------
# Set this in GitHub Repository -> Settings -> Secrets and variables -> Actions.
# Used by .github/workflows/keep-alive.yml to send pings every 5 minutes.
RENDER_BACKEND_URL=https://site-compiler.onrender.com

# ------------------------------------------------------------------------------
# FIREBASE (Auth & Firestore for Export History)
# ------------------------------------------------------------------------------
# Set this in your hosting environment (Render / Netlify / Vercel).
# The Admin SDK needs a service account to read/write Firestore.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"site-compiler",...}
